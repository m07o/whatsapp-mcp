{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatsapp-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "secrets": { "required": ["SECRET"] },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "0bc55350d7fb4ebcb99423e4b2177f5a"
    }
  ],
  "ratelimits": [
    { "name": "SIGN_IN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "TIMEZONE": "Africa/Cairo",
    "TRANSCRIBE_MODEL": "off",
    "DESCRIBE_MODEL": "off",
    "TRANSCRIBE_LANGUAGE": "",
    "DESCRIBE_LANGUAGE": "",
    "AUTH_MODE": "both",
    "WEBHOOK_TOOLS": "manage"
  },
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT", "class_name": "WhatsAppAccount" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WhatsAppAccount"] }]
}
